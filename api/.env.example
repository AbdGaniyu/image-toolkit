# Origin(s) allowed to call the API from a browser (CORS). Comma-separated.
# Defaults to http://localhost:3000 when unset.
ALLOWED_ORIGIN=http://localhost:3000

# Folder holding the background-removal model (u2netp.onnx); it's downloaded
# there on first start if missing. Defaults to ~/.cache/image-toolkit; the
# Docker image sets /models.
# MODEL_DIR=
